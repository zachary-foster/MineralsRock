<Defs>

  <ThingDef Name="WeatheredIronBase" ParentName="WeatheredOre" Class="MineralsFramework.ThingDef_StaticMineral" Abstract="True">
    <defName>WeatheredIron</defName>
    <label>Weathered iron deposits</label>
    <description>Weathered rock containing veins of iron</description>
    <graphicData>
	    <colorTwo>(130,108,101)</colorTwo>
    </graphicData>
    <randomlyDropResources>
      <li>
        <ResourceDefName>DankPyon_IronOre</ResourceDefName>
        <DropProbability>3</DropProbability>
        <CountPerDrop>10</CountPerDrop>
      </li>
    </randomlyDropResources>
    <ThingsToReplace>
      <li>DankPyon_MineableIron</li>
    </ThingsToReplace>
    <!-- How easy it is to mine -->
    <mineSpeedFactor>1.0</mineSpeedFactor>
  </ThingDef>

