  <ThingDef Name="MR_WeatheredCoalBase" ParentName="MF_WeatheredOreBase" Class="MineralsFramework.ThingDef_StaticMineral" Abstract="True">
    <defName>MR_WeatheredCoal</defName>
    <label>Weathered coal deposits</label>
    <description>Weathered rock containing veins of coal</description>
    <uiIconPath>Things/Rock/WeatheredSlate/WeatheredSlateA</uiIconPath>
    <graphicData>
      <shaderType>CutoutComplex</shaderType>
      <texPath>Things/Rock/WeatheredSlate</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <color>(60,50,50)</color>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <!-- The size range -->
    <visualSizeRange>
      <min>2.2</min>
      <max>2.4</max>
    </visualSizeRange>
    <!-- If the primary color is based on the stone below it -->
    <coloredByTerrain>false</coloredByTerrain>
    <randomlyDropResources>
      <li>
        <ResourceDefName>DankPyon_Coal</ResourceDefName>
        <DropProbability>3</DropProbability>
        <CountPerDrop>10</CountPerDrop>
        <ScaleYieldBySkill>false</ScaleYieldBySkill>
      </li>
      <li>
        <ResourceDefName>SmallFossil</ResourceDefName>
        <DropProbability>0.04</DropProbability>
        <CountPerDrop>1</CountPerDrop>
        <MinMiningSkill>8</MinMiningSkill>
      </li>
    </randomlyDropResources>
    <ThingsToReplace>
      <li>DankPyon_MineableCoal</li>
    </ThingsToReplace>
    <!-- How easy it is to mine -->
    <mineSpeedFactor>1.2</mineSpeedFactor>
  </ThingDef>

