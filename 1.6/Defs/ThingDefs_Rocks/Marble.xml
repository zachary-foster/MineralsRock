  <ThingDef Name="MR_BoulderMarble" ParentName="MF_BoulderMarbleBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_BoulderMarble</defName>
    <label>Marble Boulder</label>
    <description>Marble boulder. These can be climbed over with some difficulty and provide good cover.</description>
    <graphicData>
      <color>(132,135,132)</color>
    </graphicData>
    <randomColorsOne>
      <li>(125,130,125)</li>
    </randomColorsOne>
    <randomColorsTwo>
      <li>(220,220,220)</li>
    </randomColorsTwo>
    <building>
      <mineableThing>ChunkMarble</mineableThing>
      <mineableDropChance>0.6</mineableDropChance>
    </building>
    <!-- How nearby things or terrains affect spawn abundance -->
    <nearbyThingAbundEffects>
      <li>
        <defNames>
          <li>Marble_Rough</li>
          <li>MR_WeatheredMarble</li>
          <li>MR_SolidMarble</li>
          <li>Marble</li>
        </defNames>
        <radius>8</radius>
        <foundFactor>5</foundFactor>
        <notFoundFactor>0</notFoundFactor>
        <scaleByDistance>true</scaleByDistance>
      </li>
      <li>
        <defNames>
          <li>MR_WeatheredMarble</li>
          <li>Marble</li>
        </defNames>
        <radius>2</radius>
        <foundFactor>10</foundFactor>
        <notFoundFactor>1</notFoundFactor>
        <scaleByArea>true</scaleByArea>
        <scaleFalloff>0.5</scaleFalloff>
      </li>
    </nearbyThingAbundEffects>
    <!-- Things this mineral replaces when a map is initialized -->
    <thingsToReplace>
      <li>ChunkMarble</li>
    </thingsToReplace>
  </ThingDef>


