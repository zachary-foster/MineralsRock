<?xml version="1.0" encoding="UTF-8"?>
<Defs>


  <ThingDef Name="MR_WeatheredMarble" ParentName="MF_WeatheredMarbleBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_WeatheredMarble</defName>
    <label>Weathered Marble</label>
    <description>An impassable mass of weathered marble, a metamorphic rock of metled and recrystallized limestone. Its consistency and softness make it an attractive building material.</description>
    <graphicData>
      <color>(132,135,132)</color>
    </graphicData>
    <randomColorsOne>
      <li>(125,130,125)</li>
    </randomColorsOne>
    <randomColorsTwo>
      <li>(220,220,220)</li>
    </randomColorsTwo>
    <building>
      <mineableThing>ChunkMarble</mineableThing>
      <mineableDropChance>0.3</mineableDropChance>
    </building>
    <!-- The terrains this can appear on. -->
    <allowedTerrains>
      <li>Marble_Rough</li>
    </allowedTerrains>
    <!-- The terrains this must be near to, but not necessarily on -->
    <neededNearbyTerrains>
      <li>Marble_Rough</li>
    </neededNearbyTerrains>
    <!-- The terrains this must be near to, but not necessarily on -->
    <associatedOres>
      <li>MR_SolidMarble</li>
      <li>Marble</li>
    </associatedOres>
    <!-- Things this mineral replaces when a map is initialized -->
    <ThingsToReplace>
      <li>Marble</li>
    </ThingsToReplace>
  </ThingDef>


