<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  
  <ThingDef Name="MR_WeatheredLimestone" ParentName="MF_WeatheredLimestoneBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_WeatheredLimestone</defName>
    <label>Weathered Limestone</label>
    <description>Weathered masses of eroded limestone, a sedimentary rock composed of the shells of long-dead sealife. It makes a good building material and is easily quarried.</description>
    <graphicData>
      <color>(158,153,135)</color>
    </graphicData>
    <randomColorsOne>
      <li>(158,153,135)</li>
    </randomColorsOne>
    <randomColorsTwo>
      <li>(168,163,145)</li>
    </randomColorsTwo>
    <building>
      <mineableThing>ChunkLimestone</mineableThing>
      <mineableDropChance>0.4</mineableDropChance>
    </building>
    <!-- How nearby things or terrains affect spawn abundance -->
    <nearbyThingAbundEffects>
      <li>
        <defNames>
          <li>Limestone_Rough</li>
        </defNames>
        <radius>0</radius>
        <foundFactor>1</foundFactor>
        <notFoundFactor>0</notFoundFactor>
      </li>
      <li>
        <defNames>
          <li>Limestone_Rough</li>
        </defNames>
        <radius>5</radius>
        <foundFactor>5</foundFactor>
        <notFoundFactor>1</notFoundFactor>
        <scaleByArea>true</scaleByArea>
        <scaleByDistance>true</scaleByDistance>
      </li>
    </nearbyThingAbundEffects>
    <!-- Things this mineral replaces when a map is initialized -->
    <thingsToReplace>
      <li>Limestone</li>
    </thingsToReplace>
    <!-- List of defnames (if they exist) that this should be used as a template to create new defs for by replacing occurances of a string with each defname -->
    <templateReplaceString>Limestone</templateReplaceString>
    <isTemplateFor>
      <li>Gneiss</li>
      <li>Quartzite</li>
    </isTemplateFor>
  </ThingDef>

  
