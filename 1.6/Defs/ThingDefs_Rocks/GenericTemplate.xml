<?xml version="1.0" encoding="UTF-8"?>
<Defs>


  <ThingDef Name="MR_WeatheredGenericRockTemplate" ParentName="MF_WeatheredLimestoneBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_WeatheredGenericRockTemplate</defName>
    <label>Weathered GenericRockTemplate</label>
    <description>A template rock. You should not see this descirption if things are working correctly</description>
    <building>
      <mineableThing>ChunkLimestone</mineableThing>
      <mineableDropChance>0.3</mineableDropChance>
      <mineablePreventMeteorite>true</mineablePreventMeteorite>
    </building>
    <graphicData>
      <color>(255,192,203)</color>
    </graphicData>
    <!-- How nearby things or terrains affect spawn abundance -->
    <nearbyThingAbundEffects>
      <li>
        <defNames>
          <li>GenericRockTemplate_Rough</li>
        </defNames>
        <radius>0</radius>
        <foundFactor>1</foundFactor>
        <notFoundFactor>0</notFoundFactor>
      </li>
      <li>
        <defNames>
          <li>MR_SolidGenericRockTemplate</li>
        </defNames>
        <radius>1</radius>
        <foundFactor>3</foundFactor>
        <notFoundFactor>1</notFoundFactor>
      </li>
    </nearbyThingAbundEffects>
    <!-- Things this mineral replaces when a map is initialized -->
    <thingsToReplace>
      <li>GenericRockTemplate</li>
    </thingsToReplace>
    <!-- Other resources it might drop -->
    <randomlyDropResources Inherit="False">
      <li>
        <resourceDefName>MS_RoughGem</resourceDefName>
        <dropProbability>0.02</dropProbability>
        <minMiningSkill>4</minMiningSkill>
      </li>
      <li>
        <resourceDefName>CrushedStone</resourceDefName>
        <dropProbability>2</dropProbability>
        <countPerDrop>5</countPerDrop>
        <wasteProduct>true</wasteProduct>
      </li>
    </randomlyDropResources>
    <!-- Tags which determine how some options behave  -->
    <tags>
      <li>generic_rock_template</li>
    </tags>
    <!-- List of defnames (if they exist) that this should be used as a template to create new defs for by replacing occurances of a string with each defname -->
    <templateReplaceString>GenericRockTemplate</templateReplaceString>
    <isTemplateFor>
    </isTemplateFor>
  </ThingDef>


