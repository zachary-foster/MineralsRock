<?xml version="1.0" encoding="UTF-8"?>
<Defs>


  <ThingDef Name="MR_WeatheredGranite" ParentName="MF_WeatheredGraniteBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_WeatheredGranite</defName>
    <label>Weathered Granite</label>
    <description>Large masses of eroded granite. Granite is an igenous rock which cooled slowly deep underground, allowing for large crystals to form. Is hardness and consistency make it a great building material, but it is hard to mine.</description>
    <graphicData>
      <color>(105,95,97)</color>
    </graphicData>
    <randomColorsOne>
      <li>(105,95,97)</li>
      <li>(103,95,97)</li>
      <li>(105,98,97)</li>
      <li>(106,95,99)</li>
      <li>(105,95,97)</li>
      <li>(108,98,100)</li>
      <li>(102,92,95)</li>
    </randomColorsOne>
    <randomColorsTwo>
      <li>(205,200,198)</li>
      <li>(205,200,195)</li>
      <li>(205,200,190)</li>
      <li>(182,180,178)</li>
      <li>(182,180,175)</li>
      <li>(182,180,170)</li>
    </randomColorsTwo>
    <building>
      <mineableThing>ChunkGranite</mineableThing>
      <mineableDropChance>0.25</mineableDropChance>
    </building>
    <!-- How nearby things or terrains affect spawn abundance -->
    <nearbyThingAbundEffects>
      <li>
        <defNames>
          <li>Granite_Rough</li>
        </defNames>
        <radius>0</radius>
        <foundFactor>1</foundFactor>
        <notFoundFactor>0</notFoundFactor>
      </li>
      <li>
        <defNames>
          <li>MR_SolidGranite</li>
        </defNames>
        <radius>1</radius>
        <foundFactor>1</foundFactor>
        <notFoundFactor>0</notFoundFactor>
      </li>
    </nearbyThingAbundEffects>
    <!-- Things this mineral replaces when a map is initialized -->
    <thingsToReplace>
      <li>Granite</li>
    </thingsToReplace>
    <!-- List of defnames (if they exist) that this should be used as a template to create new defs for by replacing occurances of a string with each defname -->
    <templateReplaceString>Granite</templateReplaceString>
    <isTemplateFor>
      <li>Syenite</li>
      <li>Gabbro</li>
      <li>Diorite</li>
      <li>Dunite</li>
      <li>Pegmatite</li>
    </isTemplateFor>
  </ThingDef>


