<?xml version="1.0" encoding="UTF-8"?>
<Defs>


  <ThingDef Name="MR_WeatheredGranite" ParentName="MF_WeatheredIntrusiveIgneousRockBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_WeatheredGranite</defName>
    <label>Weathered Granite</label>
    <description>Large masses of eroded granite. Granite is an igenous rock which cooled slowly deep underground, allowing for large crystals to form. Is hardness and consistency make it a great building material, but it is hard to mine.</description>
    <graphicData>
      <color>(105,95,97)</color>
    </graphicData>
    <randomColorsOne>
      <li>(105,95,97)</li>
      <li>(103,95,97)</li>
      <li>(105,98,97)</li>
      <li>(106,95,99)</li>
      <li>(105,95,97)</li>
      <li>(108,98,100)</li>
      <li>(102,92,95)</li>
    </randomColorsOne>
    <randomColorsTwo>
      <li>(205,200,198)</li>
      <li>(205,200,195)</li>
      <li>(205,200,190)</li>
      <li>(182,180,178)</li>
      <li>(182,180,175)</li>
      <li>(182,180,170)</li>
    </randomColorsTwo>
    <building>
      <mineableThing>ChunkGranite</mineableThing>
      <mineableDropChance>0.25</mineableDropChance>
    </building>
    <!-- The terrains this can appear on. -->
    <allowedTerrains>
      <li>Granite_Rough</li>
    </allowedTerrains>
    <!-- The terrains this must be near to, but not necessarily on -->
    <neededNearbyTerrains>
      <li>Granite_Rough</li>
    </neededNearbyTerrains>
    <!-- Things this mineral replaces when a map is initialized -->
    <ThingsToReplace>
      <li>Granite</li>
    </ThingsToReplace>
  </ThingDef>


