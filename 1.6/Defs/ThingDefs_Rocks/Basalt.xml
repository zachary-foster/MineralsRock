<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <ThingDef Name="MR_BasaltBase" ParentName="UglyRockBase">
    <defName>MR_BasaltBase</defName>
    <label>basalt</label>
    <description>Basalt is a very hard igneous rock.</description>
    <graphicData>
      <color>(100,100,100)</color>
    </graphicData>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
    </statBases>
    <building>
      <mineableThing>MR_ChunkBasalt</mineableThing>
      <mineableDropChance>0.4</mineableDropChance>
    </building>
  </ThingDef>


  <ThingDef Name="MR_WeatheredBasalt" ParentName="MF_WeatheredBasaltBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_WeatheredBasalt</defName>
    <label>Weathered Basalt</label>
    <description>A wall of rough weathered basalt, the most common igneous rock. It makes a good building material but is difficult to mine.</description>
    <graphicData>
      <color>(100,100,100)</color>
    </graphicData>
    <building>
      <mineableThing>MR_ChunkBasalt</mineableThing>
      <mineableDropChance>0.4</mineableDropChance>
    </building>
    <!-- The terrains this can appear on. -->
    <allowedTerrains>
      <li>MR_BasaltBase_Rough</li>
    </allowedTerrains>
    <!-- The terrains this must be near to, but not necessarily on -->
    <neededNearbyTerrains>
      <li>MR_WeatheredBasalt</li>
    </neededNearbyTerrains>
    <!-- Things this mineral replaces when a map is initialized -->
    <ThingsToReplace>
      <li>MR_BasaltBase</li>
    </ThingsToReplace>
    <!-- List of defnames (if they exist) that this should be used as a template to create new defs for by replacing occurances of a string with each defname -->
    <templateReplaceString>Basalt</templateReplaceString>
    <isTemplateFor>
      <li>Andesite</li>
    </isTemplateFor>
  </ThingDef>


  <ThingDef Name="MR_SolidBasalt" ParentName="MF_SolidBasaltBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_SolidBasalt</defName>
    <label>Solid Basalt</label>
    <description>A solid wall of basalt, composed of deep layers of ancient lava flows.  It makes a good building material but is difficult to quarry.</description>
    <graphicData>
      <color>(100,100,100)</color>
    </graphicData>
    <building>
      <mineableThing>MR_ChunkBasalt</mineableThing>
      <mineableDropChance>0.4</mineableDropChance>
    </building>
    <!-- The terrains this can appear on. -->
    <allowedTerrains>
      <li>MR_BasaltBase_Rough</li>
    </allowedTerrains>
    <!-- Things this mineral replaces when a map is initialized -->
    <ThingsToReplace>
      <li>MR_BasaltBase</li>
    </ThingsToReplace>
    <!-- List of defnames (if they exist) that this should be used as a template to create new defs for by replacing occurances of a string with each defname -->
    <templateReplaceString>Basalt</templateReplaceString>
    <isTemplateFor>
      <li>Andesite</li>
    </isTemplateFor>
  </ThingDef>


  <ThingDef Name="MR_HewnBasalt" ParentName="MF_HewnBasaltBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_HewnBasalt</defName>
    <label>Hewn Basalt</label>
    <description>A hewn wall of basalt, composed of deep layers of ancient lava flows.  It makes a good building material but is difficult to quarry.</description>
    <graphicData>
      <color>(100,100,100)</color>
    </graphicData>
    <building>
      <mineableThing>MR_ChunkBasalt</mineableThing>
      <mineableDropChance>0.4</mineableDropChance>
      <smoothedThing>MR_SmoothedBasalt</smoothedThing>
    </building>
    <!-- The terrains this can appear on. -->
    <allowedTerrains>
      <li>MR_BasaltBase_Rough</li>
    </allowedTerrains>
    <!-- The terrains this must be near to, but not necessarily on -->
    <neededNearbyTerrains>
      <li>MR_BasaltBase_Rough</li>
    </neededNearbyTerrains>
    <!-- Things this mineral replaces when a map is initialized -->
    <ThingsToReplace>
      <li>MR_BasaltBase</li>
    </ThingsToReplace>
    <!-- List of defnames (if they exist) that this should be used as a template to create new defs for by replacing occurances of a string with each defname -->
    <templateReplaceString>Basalt</templateReplaceString>
    <isTemplateFor>
      <li>Andesite</li>
    </isTemplateFor>
  </ThingDef>


  <ThingDef Name="MR_SmoothedBasalt" ParentName="MF_SmoothedBasaltBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_SmoothedBasalt</defName>
    <label>Smooth Basalt</label>
    <description>A smooth wall of basalt, composed of deep layers of ancient lava flows. Its a bit dull.</description>
    <graphicData>
      <color>(100,100,100)</color>
    </graphicData>
    <building>
      <mineableThing>MR_ChunkBasalt</mineableThing>
      <mineableDropChance>0.4</mineableDropChance>
    </building>
    <!-- List of defnames (if they exist) that this should be used as a template to create new defs for by replacing occurances of a string with each defname -->
    <templateReplaceString>Basalt</templateReplaceString>
    <isTemplateFor>
      <li>Andesite</li>
    </isTemplateFor>
  </ThingDef>


  <ThingDef Name="MR_BoulderBasalt" ParentName="MF_BoulderBasaltBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_BoulderBasalt</defName>
    <label>Basalt boulder</label>
    <description>Basalt boulder. These can be climbed over with some difficulty and provide good cover.</description>
    <graphicData>
      <color>(100,100,100)</color>
    </graphicData>
    <building>
      <mineableThing>MR_ChunkBasalt</mineableThing>
      <mineableDropChance>.6</mineableDropChance>
    </building>
    <!-- The terrains this must be near to, but not necessarily on -->
    <neededNearbyTerrains>
      <li>MR_BasaltBase_Rough</li>
      <li>MR_WeatheredBasalt</li>
      <li>MR_SolidBasalt</li>
      <li>MR_BoulderBasalt</li>
    </neededNearbyTerrains>
    <!-- how far away it can be from needed nearby terrains-->
    <neededNearbyTerrainRadius>6</neededNearbyTerrainRadius>
    <!-- Controls how extra clusters are added near assocaited ore-->
    <associatedOres>
      <li>MR_WeatheredBasalt</li>
      <li>MR_SolidBasalt</li>
    </associatedOres>
    <nearAssociatedOreBonus>10</nearAssociatedOreBonus>
    <!-- Things this mineral replaces when a map is initialized -->
    <ThingsToReplace>
      <li>MR_ChunkBasalt</li>
    </ThingsToReplace>
    <!-- List of defnames (if they exist) that this should be used as a template to create new defs for by replacing occurances of a string with each defname -->
    <templateReplaceString>Basalt</templateReplaceString>
    <isTemplateFor>
      <li>Andesite</li>
    </isTemplateFor>
  </ThingDef>


  <ThingDef Name="MR_SmallBasalt" ParentName="MF_SmallBasaltBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_SmallBasalt</defName>
    <label>Basalt rocks</label>
    <description>Basalt rocks that are easily walked over and provide little cover.</description>
    <graphicData>
      <color>(100,100,100)</color>
    </graphicData>
    <building>
      <mineableThing>MR_ChunkBasalt</mineableThing>
      <mineableDropChance>0.3</mineableDropChance>
    </building>
    <!-- The terrains this must be near to, but not necessarily on -->
    <neededNearbyTerrains>
      <li>MR_BasaltBase_Rough</li>
      <li>MR_WeatheredBasalt</li>
      <li>MR_SolidBasalt</li>
      <li>MR_BoulderBasalt</li>
      <li>MR_PassableBasalt</li>
    </neededNearbyTerrains>
    <!-- how far away it can be from needed nearby terrains-->
    <neededNearbyTerrainRadius>2</neededNearbyTerrainRadius>
    <!-- Controls how extra clusters are added near assocaited ore-->
    <associatedOres>
      <li>MR_BasaltBase_Rough</li>
      <li>MR_BoulderBasalt</li>
      <li>MR_WeatheredBasalt</li>
      <li>MR_SolidBasalt</li>
    </associatedOres>
    <nearAssociatedOreBonus>3</nearAssociatedOreBonus>
    <!-- List of defnames (if they exist) that this should be used as a template to create new defs for by replacing occurances of a string with each defname -->
    <templateReplaceString>Basalt</templateReplaceString>
    <isTemplateFor>
      <li>Andesite</li>
    </isTemplateFor>
  </ThingDef>


  <ThingDef Name="MR_LavaFlowBasalt" ParentName="MF_LavaFlowBasaltBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_LavaFlowBasalt</defName>
    <label>Basalt lava flow</label>
    <description>A weathered lava flow. This was once a river of molted rock, but has since cooled and shattered. Very difficult to walk over but provides little cover in a gunfight.</description>
    <graphicData>
      <color>(100,100,100)</color>
    </graphicData>
    <building>
      <mineableThing>MR_ChunkBasalt</mineableThing>
      <mineableDropChance>0.5</mineableDropChance>
    </building>
    <!-- The terrains this must be near to, but not necessarily on -->
    <neededNearbyTerrains>
      <li>MR_BasaltBase_Rough</li>
      <li>MR_WeatheredBasalt</li>
      <li>MR_SolidBasalt</li>
      <li>MR_BoulderBasalt</li>
      <li>MR_PassableBasalt</li>
      <li>MR_LavaFlowBasalt</li>
    </neededNearbyTerrains>
    <!-- how far away it can be from needed nearby terrains-->
    <neededNearbyTerrainRadius>10</neededNearbyTerrainRadius>
    <!-- Controls how extra clusters are added near assocaited ore-->
    <associatedOres>
      <li>MR_BasaltBase_Rough</li>
      <li>MR_BoulderBasalt</li>
      <li>MR_WeatheredBasalt</li>
      <li>MR_SolidBasalt</li>
    </associatedOres>
    <nearAssociatedOreBonus>3</nearAssociatedOreBonus>
    <!-- List of defnames (if they exist) that this should be used as a template to create new defs for by replacing occurances of a string with each defname -->
    <templateReplaceString>Basalt</templateReplaceString>
    <isTemplateFor>
      <li>Andesite</li>
    </isTemplateFor>
  </ThingDef>


  <RecipeDef ParentName="MakeStoneBlocksBase">
    <defName>Make_StoneBlocksBasalt</defName>
    <label>Make Basalt</label>
    <description>Cuts Basalt chunks into usable blocks.</description>
    <recipeUsers Inherit="False">
      <li>TableStonecutter</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MR_ChunkBasalt</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MR_ChunkBasalt</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MR_BlocksBasalt>20</MR_BlocksBasalt>
    </products>
  </RecipeDef>


</Defs>
