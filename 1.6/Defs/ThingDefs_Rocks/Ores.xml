  <ThingDef ParentName="MF_WeatheredOreBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MF_WeatheredOreBaseSteel</defName>
    <label>Weathered Steel Deposits</label>
    <graphicData>
      <color>(105,95,97)</color>
      <colorTwo>(155,133,107)</colorTwo>
    </graphicData>
    <description>Deposits of steel. Steel has a variety of uses as an economic metal, being abundant and easy to process. It can be strengthened by being mixed with other metals into alloys.</description>
    <randomlyDropResources>
      <li>
        <resourceDefName>Sulfur</resourceDefName>
        <dropProbability>0.3</dropProbability>
        <countPerDrop>10</countPerDrop>
