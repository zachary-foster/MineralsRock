<?xml version="1.0" encoding="UTF-8"?>
<Defs>


  <ThingDef Name="MR_WeatheredSlate" ParentName="MF_WeatheredSlateBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_WeatheredSlate</defName>
    <label>Weathered Slate</label>
    <description>A weathered wall of slate, a fine-grained metamorphic rock formed from compacted volcanic ash or silt. Some of these naturally rectangular stones can be used for building without stonecutting.</description>
    <graphicData>
      <color>(70,70,70)</color>
    </graphicData>
    <building>
      <mineableThing>ChunkSlate</mineableThing>
      <mineableDropChance>0.1</mineableDropChance>
    </building>
    <!-- How nearby things or terrains affect spawn abundance -->
    <nearbyThingAbundEffects>
      <li>
        <defNames>
          <li>Slate_Rough</li>
        </defNames>
        <radius>0</radius>
        <foundFactor>1</foundFactor>
        <notFoundFactor>0</notFoundFactor>
      </li>
    </nearbyThingAbundEffects>
    <!-- Other resources it might drop -->
    <randomlyDropResources>
      <li>
        <resourceDefName>BlocksSlate</resourceDefName>
        <dropProbability>1</dropProbability>
        <countPerDrop>5</countPerDrop>
      </li>
    </randomlyDropResources>
    <!-- Things this mineral replaces when a map is initialized -->
    <thingsToReplace>
      <li>Slate</li>
    </thingsToReplace>
    <!-- List of defnames (if they exist) that this should be used as a template to create new defs for by replacing occurances of a string with each defname -->
    <templateReplaceString>Slate</templateReplaceString>
    <isTemplateFor>
      <li>Schist</li>
    </isTemplateFor>
  </ThingDef>


  <ThingDef Name="MR_SolidSlate" ParentName="MF_SolidSlateBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_SolidSlate</defName>
    <label>Solid Slate</label>
    <description>A solid wall of slate, a fine-grained metamorphic rock formed from compacted volcanic ash or silt. Some of these naturally rectangular stones can be used for building without stonecutting.</description>
    <graphicData>
      <color>(65,65,65)</color>
    </graphicData>
    <building>
      <mineableThing>ChunkSlate</mineableThing>
      <mineableDropChance>0.1</mineableDropChance>
      <mineablePreventMeteorite>true</mineablePreventMeteorite>
    </building>
    <!-- The size range -->
    <visualSizeRange>
      <min>2.3</min>
      <max>2.5</max>
    </visualSizeRange>
    <!-- Other resources it might drop -->
    <randomlyDropResources>
      <li>
        <resourceDefName>BlocksSlate</resourceDefName>
        <dropProbability>1.2</dropProbability>
        <countPerDrop>5</countPerDrop>
      </li>
    </randomlyDropResources>
    <!-- Things this mineral replaces when a map is initialized -->
    <thingsToReplace>
      <li>Slate</li>
    </thingsToReplace>
    <!-- List of defnames (if they exist) that this should be used as a template to create new defs for by replacing occurances of a string with each defname -->
    <templateReplaceString>Slate</templateReplaceString>
    <isTemplateFor>
      <li>Schist</li>
    </isTemplateFor>
  </ThingDef>


