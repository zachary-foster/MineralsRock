<?xml version="1.0" encoding="UTF-8"?>
<Defs>


  <ThingDef Name="MR_WeatheredSlate" ParentName="MF_WeatheredSlateBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_WeatheredSlate</defName>
    <label>Weathered Slate</label>
    <description>A weathered wall of slate, a fine-grained metamorphic rock formed from compacted volcanic ash or silt. Some of these naturally rectangular stones can be used for building without stonecutting.</description>
    <graphicData>
      <color>(70,70,70)</color>
    </graphicData>
    <building>
      <mineableThing>ChunkSlate</mineableThing>
      <mineableDropChance>0.1</mineableDropChance>
    </building>
    <!-- The terrains this can appear on. -->
    <allowedTerrains>
      <li>Slate_Rough</li>
    </allowedTerrains>
    <!-- The terrains this must be near to, but not necessarily on -->
    <neededNearbyTerrains>
      <li>Slate_Rough</li>
    </neededNearbyTerrains>
    <!-- Other resources it might drop -->
    <randomlyDropResources>
      <li>
        <ResourceDefName>BlocksSlate</ResourceDefName>
        <DropProbability>1</DropProbability>
        <CountPerDrop>5</CountPerDrop>
      </li>
    </randomlyDropResources>
    <!-- Things this mineral replaces when a map is initialized -->
    <ThingsToReplace>
      <li>Slate</li>
    </ThingsToReplace>
  </ThingDef>


  <ThingDef Name="MR_SolidSlate" ParentName="MF_SolidSlateBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_SolidSlate</defName>
    <label>Solid Slate</label>
    <description>A solid wall of slate, a fine-grained metamorphic rock formed from compacted volcanic ash or silt. Some of these naturally rectangular stones can be used for building without stonecutting.</description>
    <graphicData>
      <color>(65,65,65)</color>
    </graphicData>
    <building>
      <mineableThing>ChunkSlate</mineableThing>
      <mineableDropChance>0.1</mineableDropChance>
      <mineablePreventMeteorite>true</mineablePreventMeteorite>
    </building>
    <!-- The size range -->
    <visualSizeRange>
      <min>2.3</min>
      <max>2.5</max>
    </visualSizeRange>
    <!-- Other resources it might drop -->
    <randomlyDropResources>
      <li>
        <ResourceDefName>BlocksSlate</ResourceDefName>
        <DropProbability>1.2</DropProbability>
        <CountPerDrop>5</CountPerDrop>
      </li>
    </randomlyDropResources>
    <!-- Things this mineral replaces when a map is initialized -->
    <ThingsToReplace>
      <li>Slate</li>
    </ThingsToReplace>
  </ThingDef>


  <ThingDef Name="MR_HewnSlate" ParentName="MF_HewnSlateBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_HewnSlate</defName>
    <label>Hewn Slate</label>
    <description>A hewn wall of slate, a fine-grained metamorphic rock formed from compacted volcanic ash or silt. Some of these naturally rectangular stones can be used for building without stonecutting.</description>
    <graphicData>
      <color>(70,70,70)</color>
    </graphicData>
    <building>
      <mineableThing>ChunkSlate</mineableThing>
      <mineableDropChance>0.2</mineableDropChance>
      <smoothedThing>MR_SmoothedSlate</smoothedThing>
    </building>
    <!-- Other resources it might drop -->
    <randomlyDropResources>
      <li>
        <ResourceDefName>BlocksSlate</ResourceDefName>
        <DropProbability>0.8</DropProbability>
        <CountPerDrop>5</CountPerDrop>
      </li>
    </randomlyDropResources>
    <!-- Things this mineral replaces when a map is initialized -->
    <ThingsToReplace>
      <li>Slate</li>
    </ThingsToReplace>
  </ThingDef>


  <ThingDef Name="MR_SmoothedSlate" ParentName="MF_SmoothedSlateBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_SmoothedSlate</defName>
    <label>Smoothed slate wall</label>
    <description>A smoothed wall of slate. Its a bit dull.</description>
    <graphicData>
      <color>(70,70,70)</color>
    </graphicData>
    <building>
      <mineableThing>ChunkSlate</mineableThing>
      <mineableDropChance>0.2</mineableDropChance>
    </building>
    <statBases>
      <Beauty>0</Beauty>
    </statBases>
    <!-- Other resources it might drop -->
    <randomlyDropResources>
      <li>
        <ResourceDefName>BlocksSlate</ResourceDefName>
        <DropProbability>0.8</DropProbability>
        <CountPerDrop>5</CountPerDrop>
      </li>
    </randomlyDropResources>
  </ThingDef>


  <ThingDef Name="MR_SlateForest" ParentName="MF_SlateForestBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_SlateForest</defName>
    <label>Slate stone forest</label>
    <description>Pillars of soild slate sculpted by rain. This rare formation is quite beautiful. Some of these naturally rectangular stones can be used for building without stonecutting.</description>
    <graphicData>
      <color>(70,70,70)</color>
    </graphicData>
    <building>
      <mineableThing>ChunkSlate</mineableThing>
      <mineableDropChance>0.1</mineableDropChance>
    </building>
    <!-- The terrains this must be near to, but not necessarily on -->
    <neededNearbyTerrains>
      <li>MR_WeatheredSlate</li>
    </neededNearbyTerrains>
    <!-- Other resources it might drop -->
    <randomlyDropResources>
      <li>
        <ResourceDefName>BlocksSlate</ResourceDefName>
        <DropProbability>1.6</DropProbability>
        <CountPerDrop>5</CountPerDrop>
      </li>
    </randomlyDropResources>
  </ThingDef>


  <ThingDef Name="MR_SmallSlate" ParentName="MF_SmallSlateBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_SmallSlate</defName>
    <label>Slate rocks</label>
    <description>A pile or large slate rocks. Some of these naturally rectangular stones can be used for building without stonecutting.</description>
    <graphicData>
      <color>(70,70,70)</color>
    </graphicData>
    <!-- The terrains this must be near to, but not necessarily on -->
    <neededNearbyTerrains>
      <li>MR_WeatheredSlate</li>
      <li>MR_SlateForest</li>
      <li>MR_SolidSlate</li>
      <li>Slate_Rough</li>
    </neededNearbyTerrains>
    <!-- Controls how extra clusters are added near assocaited ore-->
    <associatedOres>
      <li>MR_WeatheredSlate</li>
      <li>MR_SlateForest</li>
    </associatedOres>
    <!-- Other resources it might drop -->
    <randomlyDropResources>
      <li>
        <ResourceDefName>BlocksSlate</ResourceDefName>
        <DropProbability>1.6</DropProbability>
        <CountPerDrop>5</CountPerDrop>
      </li>
    </randomlyDropResources>
    <!-- Things this mineral replaces when a map is initialized -->
    <ThingsToReplace>
      <li>ChunkSlate</li>
    </ThingsToReplace>
  </ThingDef>


</Defs>
