<?xml version="1.0" encoding="UTF-8"?>
<Defs>


  <ThingDef Name="MR_WeatheredSandstone" ParentName="MF_WeatheredSandstoneBase" Class="MineralsFramework.ThingDef_StaticMineral">
    <defName>MR_WeatheredSandstone</defName>
    <label>Weathered Sandstone</label>
    <description>An impassable mass of compacted sand, sculpted by weather and time into flowing shapes.</description>
    <graphicData>
      <color>(126,104,94)</color>
    </graphicData>
    <randomColorsOne>
      <li>(126,104,94)</li>
      <li>(124,104,94)</li>
      <li>(126,102,94)</li>
      <li>(126,104,92)</li>
      <li>(128,104,94)</li>
      <li>(126,106,94)</li>
      <li>(126,104,96)</li>
    </randomColorsOne>
    <randomColorsTwo>
      <li>(155,138,107)</li>
      <li>(165,145,112)</li>
      <li>(160,142,109)</li>
    </randomColorsTwo>
    <building>
      <mineableThing>ChunkSandstone</mineableThing>
      <mineableDropChance>0.3</mineableDropChance>
    </building>
    <!-- How nearby things or terrains affect spawn abundance -->
    <nearbyThingAbundEffects>
      <li>
        <defNames>
          <li>Sandstone_Rough</li>
        </defNames>
        <radius>0</radius>
        <foundFactor>1</foundFactor>
        <notFoundFactor>0</notFoundFactor>
      </li>
      <li>
        <defNames>
          <li>MR_SolidSandstone</li>
        </defNames>
        <radius>1</radius>
        <foundFactor>1</foundFactor>
        <notFoundFactor>0</notFoundFactor>
      </li>
    </nearbyThingAbundEffects>
    <!-- Things this mineral replaces when a map is initialized -->
    <thingsToReplace>
      <li>Sandstone</li>
    </thingsToReplace>
  </ThingDef>


