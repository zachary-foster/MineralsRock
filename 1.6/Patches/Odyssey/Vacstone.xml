<?xml version="1.0" encoding="UTF-8"?>
<Patch>


  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Odyssey</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>/Defs</xpath>
      <value>


        <ThingDef Name="MR_SolidVacstone" ParentName="MF_SolidVacstoneBase" Class="MineralsFramework.ThingDef_StaticMineral">
          <defName>MR_SolidVacstone</defName>
          <label>Solid Vacstone</label>
          <description>A solid wall of vacstone, a mixture of silicate rich rock and occasional streaks of unoxidized metal.</description>
          <graphicData>
            <color>(115,106,98)</color>
          </graphicData>
          <building>
            <mineableThing>ChunkVacstone</mineableThing>
            <mineableDropChance>0.4</mineableDropChance>
          </building>
          <!-- Things this mineral replaces when a map is initialized -->
          <ThingsToReplace>
            <li>Vacstone</li>
          </ThingsToReplace>
        </ThingDef>


        <ThingDef Name="MR_HewnVacstone" ParentName="MF_HewnVacstoneBase" Class="MineralsFramework.ThingDef_StaticMineral">
          <defName>MR_HewnVacstone</defName>
          <label>Hewn Vacstone</label>
          <description>A hewn wall of vacstone.</description>
          <graphicData>
            <color>(115,106,98)</color>
          </graphicData>
          <building>
            <mineableThing>ChunkVacstone</mineableThing>
            <mineableDropChance>0.4</mineableDropChance>
            <smoothedThing>MR_SmoothedVacstone</smoothedThing>
          </building>
          <!-- Things this mineral replaces when a map is initialized -->
          <ThingsToReplace>
            <li>Vacstone</li>
          </ThingsToReplace>
        </ThingDef>


        <ThingDef Name="MR_SmoothedVacstone" ParentName="MF_SmoothedVacstoneBase" Class="MineralsFramework.ThingDef_StaticMineral">
          <defName>MR_SmoothedVacstone</defName>
          <label>Smooth Vacstone</label>
          <description>A smooth wall of vacstone.</description>
          <graphicData>
            <color>(115,106,98)</color>
          </graphicData>
          <building>
            <mineableThing>ChunkVacstone</mineableThing>
            <mineableDropChance>0.4</mineableDropChance>
          </building>
        </ThingDef>


        <ThingDef Name="MR_BoulderVacstone" ParentName="MF_BoulderVacstoneBase" Class="MineralsFramework.ThingDef_StaticMineral">
          <defName>MR_BoulderVacstone</defName>
          <label>Vacstone boulder</label>
          <description>Vacstone boulder. These can be climbed over with some difficulty and provide good cover.</description>
          <graphicData>
            <color>(115,106,98)</color>
          </graphicData>
          <building>
            <mineableThing>ChunkVacstone</mineableThing>
            <mineableDropChance>.6</mineableDropChance>
          </building>
          <!-- The terrains this can appear on. The default is rocky terrains-->
          <allowedTerrains>
            <li>Vacstone_Rough</li>
          </allowedTerrains>
          <!-- The terrains this must be near to, but not necessarily on -->
          <neededNearbyTerrains>
            <li>MR_HewnVacstone</li>
            <li>MR_SolidVacstone</li>
          </neededNearbyTerrains>
          <!-- Things this mineral replaces when a map is initialized -->
          <ThingsToReplace>
            <li>ChunkVacstone</li>
          </ThingsToReplace>
        </ThingDef>


        <ThingDef Name="MR_SmallVacstone" ParentName="MF_SmallVacstoneBase" Class="MineralsFramework.ThingDef_StaticMineral">
          <defName>MR_SmallVacstone</defName>
          <label>Vacstone rocks</label>
          <description>Vacstone rocks that are easily walked over and provide little cover.</description>
          <graphicData>
            <color>(115,106,98)</color>
          </graphicData>
          <building>
            <mineableThing>ChunkVacstone</mineableThing>
            <mineableDropChance>0.3</mineableDropChance>
          </building>
          <!-- The terrains this must be near to, but not necessarily on -->
          <neededNearbyTerrains>
            <li>Vacstone_Rough</li>
            <li>MR_SolidVacstone</li>
            <li>MR_BoulderVacstone</li>
            <li>MR_PassableVacstone</li>
          </neededNearbyTerrains>
          <!-- The terrains this can appear on. The default is rocky terrains-->
          <allowedTerrains>
            <li>Vacstone_Rough</li>
          </allowedTerrains>
          <!-- Controls how extra clusters are added near assocaited ore-->
          <associatedOres>
            <li>MR_BoulderVacstone</li>
            <li>MR_SolidVacstone</li>
          </associatedOres>
        </ThingDef>


      </value>
    </match>
  </Operation>


</Patch>
